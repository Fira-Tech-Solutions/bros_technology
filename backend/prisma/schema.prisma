// backend/src/config/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Global Roles for Access Control
enum Role {
  SUPER_ADMIN // Can create categories, manage all listings
  AGENT // Can only manage their own listings (cars, houses, electronics, etc.)
}

// System Status for listings
enum ListingStatus {
  AVAILABLE
  PENDING
  SOLD
  ARCHIVED
}

// Track the state of automated social media postings
enum SyndicationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum SyndicationAction {
  NEW_POST
  EDITED
  DELETED
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  password     String
  name         String
  phone        String // Essential for buyers to contact agents
  role         Role    @default(AGENT)
  profileImage String? // Profile picture URL (Cloudinary or local)

  // Social media & contact links
  facebook  String?
  twitter   String?
  instagram String?
  linkedin  String?
  telegram  String?
  whatsapp  String?
  tiktok    String?
  youtube   String?
  website   String?

  // Custom social links not in the preset list
  customSocials Json @default("[]")

  // Password reset
  passwordResetToken   String?
  passwordResetExpires DateTime?

  listings      Listing[] // One-to-Many relationship
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Category {
  id          String @id @default(uuid())
  name        String @unique // e.g., "IPHONES_SAMSUNG", "LAPTOPS", "AIRPODS"
  displayName String // e.g., "iPhones & Samsung", "Laptops"
  icon        String // String identifier for frontend icons (e.g., "smartphone", "laptop")

  // Dynamic validation rules stored as JSON array. Example:
  // [{"field": "mileage", "type": "number", "required": true}]
  schemaRules Json

  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("categories")
}

model Listing {
  id          String        @id @default(uuid())
  title       String
  description String?       @db.Text
  price       Decimal       @db.Decimal(12, 2)
  status      ListingStatus @default(AVAILABLE)

  // Arrays store compressed WebP paths. Index [0] represents the cover photo
  images String[]

  // Flexible storage block matching the Category's dynamic schemaRules
  attributes Json

  // Custom platform-specific syndication override fields
  customTelegramCaption String? @db.Text // Optional template text customized by agent

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  agentId String?
  agent   User?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  // Real-time metrics
  viewsCount    Int @default(0)
  inquiryClicks Int @default(0)

  // Inventory tracking
  stockQuantity Int @default(0)

  // Commission tracking for admin revenue
  commissionPercent Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship to syndication logs
  syndications SyndicationLog[]

  @@index([status])
  @@index([categoryId])
  @@index([agentId])
  @@map("listings")
}

model SyndicationLog {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  platform     String // "TELEGRAM", "FACEBOOK", "INSTAGRAM"
  status       SyndicationStatus @default(PENDING)
  action       SyndicationAction @default(NEW_POST)
  channelInfo  String // Stores target channel ID or group metadata link
  messageId    Int? // Telegram message_id for tracking edits/deletes
  errorMessage String?           @db.Text // Contains raw API failure strings if push drops

  runAt DateTime @default(now())

  @@index([listingId])
  @@map("syndication_logs")
}

model SyndicationConfig {
  id          String   @id @default(uuid())
  platform    String   @unique // "TELEGRAM", "FACEBOOK", "INSTAGRAM"
  botToken    String? // Bot API token
  channelId   String? // Channel/group ID
  apiKey      String? // Additional API key if needed
  apiSecret   String? // Additional API secret if needed
  isActive    Boolean  @default(true)
  extraConfig Json? // Flexible storage for platform-specific settings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("syndication_configs")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String // e.g. "LISTING_CREATED", "SYNDICATION_SUCCESS"
  data      Json? // Extra payload (e.g. listingId)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AgentCode {
  id          String   @id @default(uuid())
  code        String   @unique
  createdById String // Admin who generated the code
  agentName   String? // Optional: name of the intended agent
  agentPhone  String? // Optional: phone of the intended agent
  isUsed      Boolean  @default(false)
  usedById    String? // Agent who used the code to register
  expiresAt   DateTime // Code expires after 30 minutes
  createdAt   DateTime @default(now())

  @@index([code])
  @@map("agent_codes")
}
